root = true

[*.cs]
# Noise for this app: style rules, or rules written for libraries.
# MA0048: file name must match the type name
dotnet_diagnostic.MA0048.severity = none
# MA0004: ConfigureAwait(false) in a UI app
dotnet_diagnostic.MA0004.severity = none
# MA0006: string.Equals instead of ==
dotnet_diagnostic.MA0006.severity = none
# MA0046: event handler signature
dotnet_diagnostic.MA0046.severity = none
# MA0051: method too long
dotnet_diagnostic.MA0051.severity = none
# MA0158: use System.Threading.Lock
dotnet_diagnostic.MA0158.severity = none
dotnet_diagnostic.MA0008.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1826.severity = none

# Backlog: real signal with existing findings. Fix them, then delete the line so the rule guards new code.
# MA0009: Regex without a timeout (ReDoS on file names)
dotnet_diagnostic.MA0009.severity = suggestion
# MA0011: Parse/TryParse without a culture
dotnet_diagnostic.MA0011.severity = suggestion
# MA0002: string collections without a comparer
dotnet_diagnostic.MA0002.severity = suggestion
# CA1305: culture-sensitive formatting or parsing
dotnet_diagnostic.CA1305.severity = suggestion
# CA1001: owns a disposable field but is not disposable
dotnet_diagnostic.CA1001.severity = suggestion
# MA0134: task not observed
dotnet_diagnostic.MA0134.severity = suggestion
dotnet_diagnostic.MA0147.severity = suggestion
# CA1068: CancellationToken should be the last parameter
dotnet_diagnostic.CA1068.severity = suggestion
# CA1852: seal Program
dotnet_diagnostic.CA1852.severity = suggestion
# CA1841: ContainsValue
dotnet_diagnostic.CA1841.severity = suggestion
