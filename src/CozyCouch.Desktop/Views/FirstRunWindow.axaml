<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CozyCouch.Desktop.ViewModels"
        xmlns:views="using:CozyCouch.Desktop.Views"
        x:Class="CozyCouch.Desktop.Views.FirstRunWindow"
        x:DataType="vm:FirstRunViewModel"
        Title="CozyCouch" Icon="/Assets/app.ico"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <!-- A choice: a panel the whole of which is the button. -->
        <Style Selector="Button.choice">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.choice:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
        </Style>
    </Window.Styles>

    <!-- Takes the focus from a text box when the viewer presses empty space (it is no tab stop). -->
    <Panel x:Name="Root" Background="Transparent" Focusable="True" IsTabStop="False" PointerPressed="OnRootPressed">
        <Panel Margin="32,12,32,32">
            <StackPanel x:Name="ChoiceStep" Spacing="20" IsVisible="{Binding IsChoice}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="emptyTitle" Text="Welcome to CozyCouch" />
                    <TextBlock Classes="muted" Text="Where are your movies and shows?" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <Button x:Name="AddFolderChoice" Classes="choice" AutomationProperties.Name="Add a folder" Command="{Binding AddFolderCommand}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Path Classes="icon" Data="M3.5 5.5 Q3.5 5 4 5 H8 L9.8 7 H16 Q16.5 7 16.5 7.5 V14.5 Q16.5 15 16 15 H4 Q3.5 15 3.5 14.5 Z" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Add a folder" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="They're on this PC." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="ConnectChoice" Classes="choice" AutomationProperties.Name="Connect to a server" Command="{Binding ConnectToServerCommand}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Path Classes="icon" Data="M5 8 A2 2 0 1 0 5 12 A2 2 0 1 0 5 8 Z M14.5 3 A2 2 0 1 0 14.5 7 A2 2 0 1 0 14.5 3 Z M14.5 13 A2 2 0 1 0 14.5 17 A2 2 0 1 0 14.5 13 Z M6.8 9.1 L12.7 5.9 M6.8 10.9 L12.7 14.1" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Connect to a server" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="Someone shared their library with you." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>

            <views:ConnectView x:Name="ConnectPanel" DataContext="{Binding Connect}" IsVisible="{Binding $parent[Window].((vm:FirstRunViewModel)DataContext).IsConnect}" />

            <StackPanel x:Name="ProblemStep" Spacing="16" IsVisible="{Binding IsSettingsProblem}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="emptyTitle" Text="Can't read the settings" />
                    <TextBlock Classes="muted" Text="Another program may have this file open. Close it and try again." TextWrapping="Wrap" />
                </StackPanel>
                <SelectableTextBlock Text="{Binding SettingsPath}" TextWrapping="Wrap" IsTabStop="False" FontSize="{DynamicResource SmallFontSize}" />
                <TextBlock Text="{Binding ProblemMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextBrush}"
                           IsVisible="{Binding ProblemMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Quit" MinWidth="88" IsCancel="True" HorizontalContentAlignment="Center" Command="{Binding QuitCommand}" />
                    <Button x:Name="TryAgainButton" Content="Try again" MinWidth="88" Classes="accent" IsDefault="True" HorizontalContentAlignment="Center" Command="{Binding TryAgainCommand}" />
                </StackPanel>
            </StackPanel>
        </Panel>
    </Panel>
</Window>
