<views:PosterHost xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:vm="using:CozyCouch.Desktop.ViewModels"
                  xmlns:views="using:CozyCouch.Desktop.Views"
                  xmlns:controls="using:CozyCouch.Desktop.Controls"
                  x:Class="CozyCouch.Desktop.Views.PosterRow"
                  x:DataType="vm:PosterCardViewModel">
    <!-- Two hit areas, as on PosterCard: the poster runs OpenCommand, the text opens the title page. -->
    <DockPanel Classes.dimmed="{Binding IsDimmed}" Margin="0,4" Background="Transparent">
        <DockPanel.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Remove from list" Command="{Binding RemoveCommand}" />
            </ContextMenu>
        </DockPanel.ContextMenu>
        <Button Classes="card" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center" Command="{Binding OpenCommand}">
            <Panel Width="48" Height="72">
                <Border CornerRadius="6" ClipToBounds="True">
                    <controls:PosterImage LocalPath="{Binding PosterLocalPath}" DecodeWidth="96" />
                </Border>
                <Border Classes="frame" CornerRadius="6" IsHitTestVisible="False" />
            </Panel>
        </Button>
        <Button Classes="card cardText" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                Command="{Binding OpenTitleCommand}" IsTabStop="{Binding CanPlay}">
            <StackPanel Spacing="2">
                <TextBlock Classes="cardTitle" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding HasSubtitle}" />
                <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding HasDetail}" />
                <ProgressBar Height="4" MinHeight="0" Minimum="0" Maximum="1" MaxWidth="240" HorizontalAlignment="Left"
                             Value="{Binding Progress}" IsVisible="{Binding HasProgress}" Margin="0,4,0,0" />
            </StackPanel>
        </Button>
    </DockPanel>
</views:PosterHost>
