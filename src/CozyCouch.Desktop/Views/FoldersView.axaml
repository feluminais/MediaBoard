<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CozyCouch.Desktop.ViewModels"
             x:Class="CozyCouch.Desktop.Views.FoldersView"
             x:DataType="vm:FoldersViewModel">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Classes="accent" Content="Add folder" VerticalAlignment="Center"
                    Command="{Binding AddFolderCommand}" />
            <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                   Foreground="{DynamicResource ErrorTextBrush}" />

        <TextBlock Classes="muted" Text="No folders yet. Add one to see your films and shows."
                   IsVisible="{Binding ShowEmpty}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Folders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderItem">
                        <Border Classes="panel" Margin="0,0,0,10" Padding="16,14">
                            <StackPanel Spacing="10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Classes="accent" Content="Locate…" IsVisible="{Binding ShowRepoint}"
                                                Command="{Binding $parent[UserControl].((vm:FoldersViewModel)DataContext).RepointCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{Binding ToggleLabel}"
                                                Command="{Binding $parent[UserControl].((vm:FoldersViewModel)DataContext).ToggleEnabledCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Remove"
                                                Command="{Binding $parent[UserControl].((vm:FoldersViewModel)DataContext).RemoveCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <SelectableTextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsTabStop="False" />
                                        <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <ProgressBar Height="3" MinHeight="0" HorizontalAlignment="Stretch"
                                                     Margin="0,4,0,0" Minimum="0" Maximum="100"
                                                     Value="{Binding ScanPercent}"
                                                     IsIndeterminate="{Binding IsScanIndeterminate}"
                                                     IsVisible="{Binding IsScanning}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- A folder can skip hundreds of subfolders: they scroll in a box instead of growing the page. -->
                                <ItemsControl ItemsSource="{Binding Ignored}" IsVisible="{Binding HasIgnored}" MaxHeight="140">
                                    <ItemsControl.Template>
                                        <ControlTemplate>
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:IgnoredFolder">
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Label}" Margin="16,0,0,0" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
