<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:vm="using:CozyCouch.Desktop.ViewModels"
        xmlns:views="using:CozyCouch.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="CozyCouch.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CozyCouch" Icon="/Assets/app.ico"
        Width="1200" Height="760" MinWidth="720" MinHeight="480"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="40">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenSearchCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:TitleGridViewModel">
            <views:GridView />
        </DataTemplate>
        <DataTemplate DataType="vm:ListViewModel">
            <views:ListView />
        </DataTemplate>
        <DataTemplate DataType="vm:TitleViewModel">
            <views:TitleView />
        </DataTemplate>
        <DataTemplate DataType="vm:FoldersViewModel">
            <views:FoldersView />
        </DataTemplate>
        <DataTemplate DataType="vm:SharingViewModel">
            <views:SharingView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ReviewViewModel">
            <views:ReviewView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <!-- Sidebar entries: muted until hovered, the page you are on in full text with an accent bar. -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="{DynamicResource NavItemHeight}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The review entry: warning text on a tinted background, so it stands out from the plain entries. -->
        <Style Selector="Button.nav.warning /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="Button.nav.warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>

        <Style Selector="Button.nav:pointerover Path.icon, Button.nav.selected Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.nav.selected Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.nav.warning Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="Button.searchPill:pointerover Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <!-- Icons, one per page. The nav template tags each with the page key. -->
        <Style Selector="Path.icon[Tag=Home]">
            <Setter Property="Data" Value="M3.5 9.2 L10 3.8 L16.5 9.2 M5.2 8 V15.8 Q5.2 16.2 5.6 16.2 H8.6 V11.8 H11.4 V16.2 H14.4 Q14.8 16.2 14.8 15.8 V8" />
        </Style>
        <Style Selector="Path.icon[Tag=Movies]">
            <Setter Property="Data" Value="M4 4.5 H16 Q16.5 4.5 16.5 5 V15 Q16.5 15.5 16 15.5 H4 Q3.5 15.5 3.5 15 V5 Q3.5 4.5 4 4.5 Z M7.5 4.5 V15.5 M12.5 4.5 V15.5 M3.5 8 H7.5 M3.5 12 H7.5 M12.5 8 H16.5 M12.5 12 H16.5" />
        </Style>
        <Style Selector="Path.icon[Tag=Shows]">
            <Setter Property="Data" Value="M4 5.5 H16 Q16.5 5.5 16.5 6 V13.5 Q16.5 14 16 14 H4 Q3.5 14 3.5 13.5 V6 Q3.5 5.5 4 5.5 Z M7.5 16.5 H12.5" />
        </Style>
        <Style Selector="Path.icon[Tag=Folders]">
            <Setter Property="Data" Value="M3.5 5.5 Q3.5 5 4 5 H8 L9.8 7 H16 Q16.5 7 16.5 7.5 V14.5 Q16.5 15 16 15 H4 Q3.5 15 3.5 14.5 Z" />
        </Style>
        <Style Selector="Path.icon[Tag=Sharing]">
            <Setter Property="Data" Value="M5 8 A2 2 0 1 0 5 12 A2 2 0 1 0 5 8 Z M14.5 3 A2 2 0 1 0 14.5 7 A2 2 0 1 0 14.5 3 Z M14.5 13 A2 2 0 1 0 14.5 17 A2 2 0 1 0 14.5 13 Z M6.8 9.1 L12.7 5.9 M6.8 10.9 L12.7 14.1" />
        </Style>
        <Style Selector="Path.icon[Tag=Settings]">
            <Setter Property="Data" Value="M3.5 6.5 H16.5 M3.5 13.5 H16.5 M7 4.5 V8.5 M13 11.5 V15.5" />
        </Style>
        <Style Selector="Path.icon[Tag=Review]">
            <Setter Property="Data" Value="M10 4 L16.8 15.6 Q17 16 16.5 16 H3.5 Q3 16 3.2 15.6 Z M10 8.5 V11.8 M10 13.8 V13.9" />
        </Style>
        <Style Selector="Path.icon.search">
            <Setter Property="Data" Value="M9 3.8 A5.2 5.2 0 1 0 9 14.2 A5.2 5.2 0 1 0 9 3.8 Z M12.9 12.9 L16.3 16.3" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="-1,0,0,0" />
        </Style>

        <!-- The search entry in the title strip. -->
        <Style Selector="Button.searchPill">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="{DynamicResource SearchPillHeight}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource MetaFontSize}" />
        </Style>
        <Style Selector="Button.searchPill /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.searchPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <!-- Status bar -->
        <Style Selector="Button.strip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.strip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.strip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="StackPanel.busy > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
        </Style>
    </Window.Styles>

    <!-- Root takes the focus from a text box when the viewer presses empty space (it is no tab stop). -->
    <Panel x:Name="Root" Background="Transparent" Focusable="True" IsTabStop="False" PointerPressed="OnRootPressed">
        <DockPanel>
            <!-- Status bar: always visible. The key segment opens Settings and the sharing segment opens Sharing; the rest
                 toggles the activity panel. A problem segment (red) shows warnings and errors logged since the panel was
                 last open. -->
            <Border DockPanel.Dock="Bottom" Height="28"
                    Background="{DynamicResource StripBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="link" x:Name="KeyProblemButton"
                            Content="{Binding StatusBar.KeyProblem}"
                            IsVisible="{Binding StatusBar.KeyProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding StatusBar.OpenSettingsCommand}"
                            ToolTip.Tip="Open Settings" />
                    <Button DockPanel.Dock="Right" Classes="strip" x:Name="SharingSegment"
                            Content="{Binding StatusBar.Sharing}"
                            IsVisible="{Binding StatusBar.Sharing, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding StatusBar.OpenSharingCommand}"
                            ToolTip.Tip="Open Sharing" />
                    <Button Classes="strip" x:Name="StatusStrip" Command="{Binding ToggleActivityCommand}"
                            ToolTip.Tip="Activity">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                       Text="{Binding StatusBar.Connection}" />
                            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                <TextBlock x:Name="ProblemText" Text="{Binding StatusBar.Problem}"
                                           Foreground="{DynamicResource ErrorTextBrush}" MaxWidth="480"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding StatusBar.Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding StatusBar.LibraryProblem}"
                                           Foreground="{DynamicResource ErrorTextBrush}"
                                           IsVisible="{Binding StatusBar.LibraryProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding StatusBar.FailedScans}"
                                           Foreground="{DynamicResource ErrorTextBrush}" MaxWidth="480" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding StatusBar.FailedScans, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <!-- Scanning or identifying: a small bar and the accent colour, so it stands out from "Up to date". -->
                                <StackPanel x:Name="BusySegment" Orientation="Horizontal" Spacing="8"
                                            Classes.busy="{Binding StatusBar.IsBusy}">
                                    <ProgressBar x:Name="BusyBar" Width="64" Height="4" MinHeight="0" MinWidth="0"
                                                 VerticalAlignment="Center" Minimum="0" Maximum="100"
                                                 Value="{Binding StatusBar.BusyPercent}"
                                                 IsIndeterminate="{Binding StatusBar.IsBusyIndeterminate}"
                                                 IsVisible="{Binding StatusBar.IsBusy}" />
                                    <TextBlock Text="{Binding StatusBar.Progress}"
                                               IsVisible="{Binding StatusBar.Progress, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text="{Binding StatusBar.Identifying}" Margin="12,0,0,0"
                                               IsVisible="{Binding StatusBar.Identifying, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusBar.UnavailableFolders}"
                                           Foreground="{DynamicResource WarningTextBrush}" MaxWidth="480" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding StatusBar.UnavailableFolders, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding StatusBar.Player, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Path Data="M0 0 L8 4.5 L0 9 Z" Fill="{DynamicResource AccentTextBrush}"
                                          Width="8" Height="9" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusBar.Player}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DockPanel>
            </Border>

            <views:ActivityPanel DockPanel.Dock="Bottom" Height="220"
                                 DataContext="{Binding Activity}"
                                 IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsActivityOpen}" />

            <!-- Sidebar: runs the full height, so the mark sits in the title strip's band. -->
            <Border DockPanel.Dock="Left" Width="{DynamicResource SidebarWidth}"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="40" Background="Transparent"
                            chrome:WindowDecorationProperties.ElementRole="TitleBar">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
                            <Image Source="avares://CozyCouch.Desktop/Assets/app-mark.png" Width="26" Height="26"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <TextBlock Text="CozyCouch" FontFamily="{StaticResource DisplayFont}" FontSize="{DynamicResource BodyFontSize}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Needs review: pinned to the bottom edge, there only while something needs review. -->
                    <Border DockPanel.Dock="Bottom" Padding="12,0,12,12">
                        <Button x:Name="ReviewNavButton" Classes="nav warning"
                                Classes.selected="{Binding ReviewItem.IsSelected}"
                                IsVisible="{Binding HasReview}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding ReviewItem.Key}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Classes="icon" Tag="Review" />
                                <TextBlock Text="{Binding ReviewItem.Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <ItemsControl ItemsSource="{Binding NavItems}" Margin="12,16,12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                        CommandParameter="{Binding Key}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.ColumnSpan="2" Width="3" Height="16" CornerRadius="2"
                                                Background="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Left" Margin="-10,0,0,0"
                                                IsVisible="{Binding IsSelected}" />
                                        <Path Classes="icon" Tag="{Binding Key}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <DockPanel>
                <!-- Title strip: a drag area with search in the middle and the window buttons at the right. The window keeps
                     the system's border and resize edge; the title bar and its buttons are drawn here. -->
                <Border DockPanel.Dock="Top" Height="40" Background="Transparent"
                        chrome:WindowDecorationProperties.ElementRole="TitleBar">
                    <Grid ColumnDefinitions="*,Auto">
                        <Button x:Name="SearchButton" Classes="searchPill" MaxWidth="420" Margin="24,0"
                                Command="{Binding OpenSearchCommand}"
                                chrome:WindowDecorationProperties.ElementRole="User">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Classes="kbd" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+F" FontSize="{DynamicResource CaptionFontSize}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="icon search" />
                                    <TextBlock Text="Search" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Classes="caption" Click="OnMinimize" ToolTip.Tip="Minimise">
                                <Path Data="M5 10.5 H15" />
                            </Button>
                            <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximize" ToolTip.Tip="Maximise">
                                <Path x:Name="MaximizeGlyph" Data="M5.5 5.5 H14.5 V14.5 H5.5 Z" />
                            </Button>
                            <Button Classes="caption close" Click="OnClose" ToolTip.Tip="Close">
                                <Path Data="M5.5 5.5 L14.5 14.5 M14.5 5.5 L5.5 14.5" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Panel>
                    <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Margin="{DynamicResource PageMargin}"
                                    IsVisible="{Binding !IsPageCovered}" />
                    <Panel x:Name="ConnectionHost" IsVisible="{Binding IsPageCovered}">
                        <views:ConnectionPanel DataContext="{Binding Connection}" Margin="{DynamicResource PageMargin}" />
                    </Panel>
                </Panel>
            </DockPanel>
        </DockPanel>

        <!-- Search palette: a dimmed backdrop (a click on it closes the palette) with the palette near the top. -->
        <Border x:Name="SearchBackdrop" IsVisible="{Binding IsSearchOpen}"
                Background="{DynamicResource OverlayBrush}"
                PointerPressed="OnBackdropPressed">
            <views:SearchPalette x:Name="Palette" DataContext="{Binding Search}"
                                 Width="600" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" />
        </Border>
    </Panel>
</Window>
