<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MediaBoard.Desktop.ViewModels"
        xmlns:views="using:MediaBoard.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="MediaBoard.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MediaBoard"
        Width="1200" Height="760" MinWidth="720" MinHeight="480">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenSearchCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CloseSearchCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:TitleGridViewModel">
            <views:GridView />
        </DataTemplate>
        <DataTemplate DataType="vm:ListViewModel">
            <views:ListView />
        </DataTemplate>
        <DataTemplate DataType="vm:TitleViewModel">
            <views:TitleView />
        </DataTemplate>
        <DataTemplate DataType="vm:FoldersViewModel">
            <views:FoldersView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ReviewViewModel">
            <views:ReviewView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <!-- The review entry: warning text on a tinted background, so it stands out from the plain entries. -->
        <Style Selector="Button.nav.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.strip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="StackPanel.busy > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Panel>
        <DockPanel>
            <!-- Status bar: always visible. The key segment opens Settings; the rest toggles the activity panel. A problem
                 segment (red) shows warnings and errors logged since the panel was last open. -->
            <Border DockPanel.Dock="Bottom" Height="30"
                    Background="{DynamicResource StripBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="link" x:Name="KeyProblemButton"
                            Content="{Binding StatusBar.KeyProblem}"
                            IsVisible="{Binding StatusBar.KeyProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding StatusBar.OpenSettingsCommand}"
                            ToolTip.Tip="Open Settings" />
                    <Button Classes="strip" x:Name="StatusStrip" Command="{Binding ToggleActivityCommand}"
                            ToolTip.Tip="Activity">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Text="{Binding StatusBar.Connection}" />
                            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                <TextBlock x:Name="ProblemText" Text="{Binding StatusBar.Problem}"
                                           Foreground="{DynamicResource ErrorTextBrush}" MaxWidth="480"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding StatusBar.Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding StatusBar.LibraryProblem}"
                                           Foreground="{DynamicResource ErrorTextBrush}"
                                           IsVisible="{Binding StatusBar.LibraryProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding StatusBar.FailedScans}"
                                           Foreground="{DynamicResource ErrorTextBrush}"
                                           IsVisible="{Binding StatusBar.FailedScans, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <!-- Scanning or identifying: a small bar and the accent colour, so it stands out from "Up to date". -->
                                <StackPanel x:Name="BusySegment" Orientation="Horizontal" Spacing="8"
                                            Classes.busy="{Binding StatusBar.IsBusy}">
                                    <ProgressBar x:Name="BusyBar" Width="64" Height="4" MinHeight="0" MinWidth="0"
                                                 VerticalAlignment="Center" Minimum="0" Maximum="100"
                                                 Value="{Binding StatusBar.BusyPercent}"
                                                 IsIndeterminate="{Binding StatusBar.IsBusyIndeterminate}"
                                                 IsVisible="{Binding StatusBar.IsBusy}" />
                                    <TextBlock Text="{Binding StatusBar.Progress}"
                                               IsVisible="{Binding StatusBar.Progress, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text="{Binding StatusBar.Identifying}" Margin="12,0,0,0"
                                               IsVisible="{Binding StatusBar.Identifying, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusBar.UnavailableFolders}"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           IsVisible="{Binding StatusBar.UnavailableFolders, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding StatusBar.Player, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="&#x25B6;" VerticalAlignment="Center" FontSize="10" />
                                    <TextBlock Text="{Binding StatusBar.Player}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DockPanel>
            </Border>

            <views:ActivityPanel DockPanel.Dock="Bottom" Height="220"
                                 DataContext="{Binding Activity}"
                                 IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsActivityOpen}" />

            <!-- Sidebar -->
            <Border DockPanel.Dock="Left" Width="200" Padding="8,12"
                    Background="{DynamicResource SidebarBrush}">
                <DockPanel>
                    <!-- Needs review: pinned to the bottom edge, there only while something needs review. -->
                    <Button DockPanel.Dock="Bottom" x:Name="ReviewNavButton" Classes="nav warning"
                            Classes.selected="{Binding ReviewItem.IsSelected}"
                            IsVisible="{Binding HasReview}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{Binding ReviewItem.Key}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#x26A0;" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ReviewItem.Label}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Spacing="2">
                        <Button Classes="nav" Command="{Binding OpenSearchCommand}" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="Ctrl+F" FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Search" />
                            </DockPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItem">
                                    <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding Key}">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Margin="32,24" />
        </DockPanel>

        <!-- Search palette: a dimmed backdrop (a click on it closes the palette) with the palette near the top. -->
        <Border x:Name="SearchBackdrop" IsVisible="{Binding IsSearchOpen}"
                Background="{DynamicResource OverlayBrush}"
                PointerPressed="OnBackdropPressed">
            <views:SearchPalette x:Name="Palette" DataContext="{Binding Search}"
                                 Width="600" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" />
        </Border>
    </Panel>
</Window>
