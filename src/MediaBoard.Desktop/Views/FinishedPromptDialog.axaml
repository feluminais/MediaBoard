<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MediaBoard.Desktop.Views.FinishedPromptDialog"
        Title="MediaBoard"
        Width="420" SizeToContent="Height" CanResize="False"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,4,24,24" Spacing="20">
        <TextBlock x:Name="Question" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="NoButton" Content="No" MinWidth="88" Classes="accent" IsDefault="True" />
            <Button x:Name="YesButton" Content="Yes" MinWidth="88" />
        </StackPanel>
    </StackPanel>
</Window>
