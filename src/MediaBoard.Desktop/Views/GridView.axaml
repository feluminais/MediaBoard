<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaBoard.Desktop.ViewModels"
             xmlns:views="using:MediaBoard.Desktop.Views"
             x:Class="MediaBoard.Desktop.Views.GridView"
             x:DataType="vm:TitleGridViewModel">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBox x:Name="FilterBox" Width="200" PlaceholderText="Filter" Text="{Binding FilterText}"
                         KeyDown="OnFilterKeyDown" />
                <TextBlock Classes="muted" Text="Sort" VerticalAlignment="Center" />
                <ComboBox MinWidth="120" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SortOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="Show hidden" IsChecked="{Binding ShowHidden}" />
            </StackPanel>
            <TextBlock Classes="pageTitle" Text="{Binding Title}" VerticalAlignment="Center" />
        </DockPanel>

        <Panel>
            <StackPanel IsVisible="{Binding ShowEmpty}" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="emptyTitle" Text="{Binding EmptyTitle}" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding EmptyHint}" HorizontalAlignment="Center"
                           IsVisible="{Binding HasEmptyHint}" />
            </StackPanel>

            <!-- ItemsRepeater builds only the cards in the scroll viewer's window and reuses them as it scrolls. -->
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="Cards" ItemsSource="{Binding Items}">
                    <ItemsRepeater.Layout>
                        <!-- The cell size follows the poster size resources; GridView binds them. -->
                        <UniformGridLayout MinItemWidth="176" MinItemHeight="304" ItemsStretch="None" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PosterCardViewModel">
                            <views:PosterCard Margin="{DynamicResource PosterCardMargin}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
