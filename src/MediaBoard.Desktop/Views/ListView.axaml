<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaBoard.Desktop.ViewModels"
             xmlns:views="using:MediaBoard.Desktop.Views"
             x:Class="MediaBoard.Desktop.Views.ListView"
             x:DataType="vm:ListViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="pageTitle" Text="{Binding Title}" Margin="0,0,0,20" />

        <Panel>
            <StackPanel IsVisible="{Binding ShowEmpty}" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="muted" Text="{Binding EmptyText}" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding EmptyHint}" HorizontalAlignment="Center"
                           IsVisible="{Binding HasEmptyHint}" />
            </StackPanel>

            <!-- Each row is a button already, so no ListBox: its items would be a second tab stop per row, with a
                 selection nothing uses. The panel only builds the rows in view. -->
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Rows" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PosterCardViewModel">
                            <views:PosterRow />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
