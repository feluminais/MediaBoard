<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaBoard.Desktop.ViewModels"
             xmlns:views="using:MediaBoard.Desktop.Views"
             x:Class="MediaBoard.Desktop.Views.ListView"
             x:DataType="vm:ListViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="pageTitle" Text="{Binding Title}" Margin="0,0,0,16" />

        <Panel>
            <StackPanel IsVisible="{Binding ShowEmpty}" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="muted" Text="{Binding EmptyText}" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding EmptyHint}" HorizontalAlignment="Center"
                           IsVisible="{Binding HasEmptyHint}" />
            </StackPanel>

            <!-- The ListBox's panel only builds the rows in view. -->
            <ListBox x:Name="Rows" ItemsSource="{Binding Items}" Background="Transparent" Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PosterCardViewModel">
                        <views:PosterRow />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
    </DockPanel>
</UserControl>
