<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaBoard.Desktop.ViewModels"
             x:Class="MediaBoard.Desktop.Views.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding EmptyText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DockPanel>
</UserControl>
