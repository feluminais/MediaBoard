<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaBoard.Desktop.ViewModels"
             xmlns:players="using:MediaBoard.Core.Players"
             x:Class="MediaBoard.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,16">
            <TextBlock Classes="pageTitle" Text="{Binding Title}" Margin="0,0,0,4" />

            <Border Classes="panel">
            <StackPanel Spacing="10">
                <TextBlock Classes="rowTitle" Text="TMDB key" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Needed to find titles, posters and ratings." />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="accent" Content="Save" Margin="8,0,0,0"
                            Command="{Binding SaveKeyCommand}" />
                    <ToggleButton DockPanel.Dock="Right" Content="Show" Margin="8,0,0,0"
                                  IsChecked="{Binding ShowKey}" />
                    <TextBox x:Name="KeyBox" Text="{Binding TmdbKey}" PasswordChar="&#x2022;"
                             RevealPassword="{Binding ShowKey}" PlaceholderText="Paste your key" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button Classes="textLink" Command="{Binding OpenHelpLinkCommand}">
                        <TextBlock Text="{Binding HelpLinkText}" TextDecorations="Underline" />
                    </Button>
                    <TextBlock Classes="muted" Text="{Binding KeyStatus}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            </Border>

            <Border Classes="panel">
            <StackPanel Spacing="10">
                <TextBlock Classes="rowTitle" Text="Player" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding BrowseLabel}" Margin="8,0,0,0"
                            Command="{Binding BrowsePlayerCommand}" />
                    <ComboBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}"
                              HorizontalAlignment="Stretch" PlaceholderText="Choose a player">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="players:PlayerInfo">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="{Binding InUse}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{Binding InUseDetail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            </Border>

            <Border Classes="panel">
            <StackPanel Spacing="10">
                <TextBlock Classes="rowTitle" Text="About" />
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" Text="{Binding Version}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Classes="tag" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TmdbMark}" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding TmdbAttribution}" TextWrapping="Wrap" MaxWidth="480"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
