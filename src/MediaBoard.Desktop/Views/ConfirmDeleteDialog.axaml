<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaBoard.Desktop.ViewModels"
        x:Class="MediaBoard.Desktop.Views.ConfirmDeleteDialog"
        x:DataType="vm:ConfirmDeleteViewModel"
        Title="Delete from disk"
        Width="560" MaxHeight="560" SizeToContent="Height" CanResize="False"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" IsDefault="True" IsCancel="True" />
            <Button x:Name="DeleteButton" Content="Delete" MinWidth="88" Classes="accent" />
        </StackPanel>
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding SizeText}" />
            <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Paths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PathRow">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Classes="muted" Text="{Binding Note}" FontSize="12"
                                           IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{Binding Seeding}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
            <TextBlock Text="{Binding PermanentWarning}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}"
                       IsVisible="{Binding HasPermanentWarning}" />
        </StackPanel>
    </DockPanel>
</Window>
