<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaBoard.Desktop.ViewModels"
             xmlns:views="using:MediaBoard.Desktop.Views"
             x:Class="MediaBoard.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:PosterCardViewModel">
            <views:PosterCard />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Panel>
        <StackPanel IsVisible="{Binding ShowError}" Spacing="8" MaxWidth="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Classes="emptyTitle" Text="Can't open the library" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding LibraryError}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowNoFolders}" Spacing="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Classes="emptyTitle" Text="No folders yet" HorizontalAlignment="Center" />
            <Button Classes="accent" Content="Add a folder" HorizontalAlignment="Center"
                    Command="{Binding AddFolderCommand}" />
            <Button Content="Add TMDB key" HorizontalAlignment="Center"
                    IsVisible="{Binding ShowKeyPrompt}" Command="{Binding AddKeyCommand}" />
        </StackPanel>

        <ScrollViewer x:Name="Page" IsVisible="{Binding ShowRows}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="32" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="rowTitle" Text="Continue watching" VerticalAlignment="Center" />
                        <Button Classes="openAll" Content="&#x203A;" ToolTip.Tip="Open all"
                                Command="{Binding OpenContinueAllCommand}" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="Nothing in progress" IsVisible="{Binding NothingInProgress}" />
                    <ScrollViewer Classes="row" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding !NothingInProgress}">
                        <ItemsControl ItemsSource="{Binding ContinueWatching}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="rowTitle" Text="Recently added" VerticalAlignment="Center" />
                        <Button Classes="openAll" Content="&#x203A;" ToolTip.Tip="Open all"
                                Command="{Binding OpenRecentAllCommand}" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="Nothing added yet" IsVisible="{Binding ShowNothingAdded}" />
                    <StackPanel Spacing="2" IsVisible="{Binding ShowBusy}">
                        <TextBlock Text="{Binding BusyTitle}" />
                        <TextBlock Classes="muted" Text="{Binding BusyLine}" />
                    </StackPanel>
                    <ScrollViewer Classes="row" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding !NothingAdded}">
                        <ItemsControl ItemsSource="{Binding RecentlyAdded}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
