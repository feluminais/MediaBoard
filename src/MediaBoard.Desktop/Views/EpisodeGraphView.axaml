<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaBoard.Desktop.ViewModels"
             xmlns:controls="using:MediaBoard.Desktop.Controls"
             xmlns:views="using:MediaBoard.Desktop.Views"
             x:Class="MediaBoard.Desktop.Views.EpisodeGraphView"
             x:DataType="vm:EpisodeGraphViewModel">
    <UserControl.Styles>
        <Style Selector="Button.modeTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="{DynamicResource MetaFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.modeTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.modeTab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="12" Margin="0,8,0,32">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsVisible="{Binding ShowModes}">
                <Button Classes="modeTab" Classes.active="{Binding ShowProgressLegend}" Content="Progress" Command="{Binding ShowProgressCommand}" />
                <Button Classes="modeTab" Classes.active="{Binding ShowRatingLegend}" Content="Ratings" Command="{Binding ShowRatingsCommand}" />
            </StackPanel>
            <TextBlock Classes="rowTitle" Text="{Binding Heading}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- What the cells mean: the rating bands, or the viewer's progress. -->
        <ItemsControl ItemsSource="{x:Static views:EpisodeGraphView.Legend}" IsVisible="{Binding ShowRatingLegend}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:LegendEntry">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                        <Ellipse Width="12" Height="12" Fill="{Binding Fill}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Classes="muted" FontSize="{DynamicResource MetaFontSize}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel IsVisible="{Binding ShowProgressLegend}">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Watched" Classes="muted" FontSize="{DynamicResource MetaFontSize}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1" VerticalAlignment="Center">
                    <Border Width="6" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" Opacity="0.6" CornerRadius="2,0,0,2" />
                </Border>
                <TextBlock Text="Started" Classes="muted" FontSize="{DynamicResource MetaFontSize}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1" VerticalAlignment="Center" />
                <TextBlock Text="Not watched" Classes="muted" FontSize="{DynamicResource MetaFontSize}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                <Border Width="14" Height="14" CornerRadius="3" BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1"
                        VerticalAlignment="Center" Opacity="0.7" />
                <TextBlock Text="No file" Classes="muted" FontSize="{DynamicResource MetaFontSize}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource WarningSurfaceBrush}" VerticalAlignment="Center" />
                <TextBlock Text="File missing" Classes="muted" FontSize="{DynamicResource MetaFontSize}" VerticalAlignment="Center" />
            </StackPanel>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding ShowStatus}">
            <TextBlock Classes="muted" Text="{Binding Status}" VerticalAlignment="Center" />
            <Button Content="Retry" Classes="small" Command="{Binding LoadCommand}" IsVisible="{Binding ShowRetry}" />
        </StackPanel>
        <TextBlock Classes="muted" Text="No episodes listed yet." IsVisible="{Binding HasNoEpisodes}" />

        <!-- The graph draws every cell itself; the card is one element moved next to the cell the pointer is on. -->
        <Panel x:Name="Host">
            <controls:EpisodeGraph x:Name="Graph" Seasons="{Binding Seasons}" Mode="{Binding Mode}" SelectedSeason="{Binding SelectedSeason}"
                                   IsChoosable="{Binding IsLibrary}" IsCompact="{Binding IsLibrary}" HorizontalAlignment="Stretch" />
            <Border x:Name="CardBox" Classes="panel" Padding="10" Width="380" HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False" ZIndex="1" DataContext="{Binding Card}" x:DataType="vm:EpisodeCardViewModel"
                    IsVisible="{Binding IsVisible}">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="128" Height="72" CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Panel>
                                <controls:PosterImage LocalPath="{Binding StillLocalPath}" DecodeWidth="256" />
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="5,1" Margin="5"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding HasRating}">
                                    <TextBlock Text="{Binding RatingText}" FontSize="{DynamicResource SmallFontSize}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnAccentBrush}" />
                                </Border>
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" FontSize="{DynamicResource SmallFontSize}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" FontSize="{DynamicResource SmallFontSize}" Text="{Binding Facts}" TextWrapping="Wrap" IsVisible="{Binding HasFacts}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource MetaFontSize}" IsVisible="{Binding HasOverview}" />
                </StackPanel>
            </Border>
        </Panel>
    </StackPanel>
</UserControl>
