<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaBoard.Desktop.ViewModels"
             x:Class="MediaBoard.Desktop.Views.FixMatchPickerView"
             x:DataType="vm:FixMatchPickerViewModel">
    <!-- The "Fix match" search, shared by the title page and Needs review. -->
    <Border Classes="panel">
        <StackPanel Spacing="10">
            <TextBlock Classes="rowTitle" Text="Fix match" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                <ComboBox DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="110"
                          ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
                <TextBox x:Name="Input" Text="{Binding Query}" PlaceholderText="Search TMDB" />
            </DockPanel>
            <TextBlock Classes="muted" Text="{Binding Message}"
                       IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ScrollViewer MaxHeight="280">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MatchChoice">
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Use this" Classes="small" VerticalAlignment="Center"
                                        Command="{Binding $parent[ItemsControl].((vm:FixMatchPickerViewModel)DataContext).PickCommand}"
                                        CommandParameter="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
