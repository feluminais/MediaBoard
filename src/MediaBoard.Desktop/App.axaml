<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MediaBoard.Desktop.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system light or dark setting. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="StripBrush" Color="#EBEBEB" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#D9D9D9" />
                    <SolidColorBrush x:Key="SelectedNavBrush" Color="#DCDCDC" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#616161" />
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5300" />
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="#B3261E" />
                    <SolidColorBrush x:Key="BadgeBrush" Color="#C25E00" />
                    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SidebarBrush" Color="#202020" />
                    <SolidColorBrush x:Key="StripBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#262626" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="SelectedNavBrush" Color="#383838" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A8A8A8" />
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#F2B866" />
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF8A80" />
                    <SolidColorBrush x:Key="BadgeBrush" Color="#C25E00" />
                    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.rowTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
</Application>
