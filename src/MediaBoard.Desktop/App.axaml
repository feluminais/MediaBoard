<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MediaBoard.Desktop.Controls"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="MediaBoard.Desktop.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system light or dark setting. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Type: one UI face, one display face for page titles. Segoe UI Variable is on Windows 11; Segoe UI covers 10. -->
            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

            <!-- Shape: three radii, used by nesting level. Controls 6, panels 10, floating surfaces 12. -->
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="PanelRadius">10</CornerRadius>
            <CornerRadius x:Key="ChipRadius">6</CornerRadius>

            <!-- Sizes: the defaults (100%, medium posters, a normal window). Sizing/UiSizes writes the live values over
                 these from the Display settings and the window's width; every view reads them as DynamicResource. -->
            <x:Double x:Key="CaptionFontSize">11</x:Double>
            <x:Double x:Key="SmallFontSize">12</x:Double>
            <x:Double x:Key="MetaFontSize">13</x:Double>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
            <x:Double x:Key="RowTitleFontSize">17</x:Double>
            <x:Double x:Key="DialogTitleFontSize">18</x:Double>
            <x:Double x:Key="EmptyTitleFontSize">20</x:Double>
            <x:Double x:Key="OpenAllFontSize">22</x:Double>
            <x:Double x:Key="PageTitleFontSize">28</x:Double>
            <x:Double x:Key="PosterWidth">160</x:Double>
            <x:Double x:Key="PosterHeight">240</x:Double>
            <x:Int32 x:Key="PosterDecodeWidth">240</x:Int32>
            <x:Double x:Key="PosterGap">16</x:Double>
            <Thickness x:Key="PosterCardMargin">0,0,16,12</Thickness>
            <x:Double x:Key="PosterCellWidth">176</x:Double>
            <x:Double x:Key="PosterCellHeight">304</x:Double>
            <x:Double x:Key="TitlePosterWidth">220</x:Double>
            <x:Double x:Key="TitlePosterHeight">330</x:Double>
            <x:Int32 x:Key="TitlePosterDecodeWidth">360</x:Int32>
            <x:Double x:Key="SidebarWidth">220</x:Double>
            <x:Double x:Key="NavItemHeight">36</x:Double>
            <x:Double x:Key="ReadingWidth">640</x:Double>
            <x:Double x:Key="SearchPillHeight">28</x:Double>
            <Thickness x:Key="PageMargin">32,12,32,0</Thickness>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Light: lavender paper, one deep violet. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SidebarBrush" Color="#EFE9FB" />
                    <SolidColorBrush x:Key="StripBrush" Color="#EFE9FB" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#DDD3F0" />
                    <SolidColorBrush x:Key="SelectedNavBrush" Color="#E3D9F6" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#EAE2F8" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#655A7A" />
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5300" />
                    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FBEBCB" />
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="#B3261E" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#6D28D9" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LinkTextBrush" Color="#5B21B6" />
                    <!-- Busy text on the status bar: the palette's accent, a shade that reads on this theme's strip. -->
                    <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="PosterPlaceholderBrush" Color="#E3D9F6" />

                    <!-- Fluent's own keys, pointed at the same palette so stock controls match. -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F5F0FD" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E9E1F7" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D6CBEA" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#BBA8DE" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#BBA8DE" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#F5F0FD" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#E9E1F7" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#D6CBEA" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#BBA8DE" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#BBA8DE" />                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#6D28D9" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#7C3AED" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#5B21B6" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D6CBEA" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#BBA8DE" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#6D28D9" />
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F5F0FD" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E9E1F7" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D6CBEA" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#BBA8DE" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D6CBEA" />
                    <SolidColorBrush x:Key="ProgressBarBackground" Color="#DDD3F0" />
                    <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#D6CBEA" />
                    <!-- Keyboard focus: a 2 px accent ring over a 1 px page-colour gap, in place of Fluent's black and white pair. -->
                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#6D28D9" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#F8F5FF" />
                </ResourceDictionary>

                <!-- Dark: true black for OLED with one vivid purple, the most saturated sRGB has. Warnings stay amber, errors coral, so the accent never reads as a state. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SidebarBrush" Color="#050208" />
                    <SolidColorBrush x:Key="StripBrush" Color="#050208" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#0E0818" />
                    <SolidColorBrush x:Key="FieldBrush" Color="#0A0612" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#251840" />
                    <SolidColorBrush x:Key="SelectedNavBrush" Color="#1C1030" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#140B22" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A99BC4" />
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#F2B866" />
                    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#33290F" />
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF8F80" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#9B3DFF" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LinkTextBrush" Color="#C59BFF" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
                    <SolidColorBrush x:Key="PosterPlaceholderBrush" Color="#1C1030" />

                    <SolidColorBrush x:Key="ButtonBackground" Color="#1A1028" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#251638" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#120A1E" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3A2A58" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#55408A" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#3A2A58" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#1A1028" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#251638" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#120A1E" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#3A2A58" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#55408A" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#3A2A58" />                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#9B3DFF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B05CFF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#8420F0" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#0A0612" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0A0612" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0A0612" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3A2A58" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#55408A" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#B05CFF" />
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#1A1028" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#251638" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#120A1E" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3A2A58" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#55408A" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#140B22" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3A2A58" />
                    <SolidColorBrush x:Key="ProgressBarBackground" Color="#2A1D44" />
                    <SolidColorBrush x:Key="ToolTipBackground" Color="#1A1028" />
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3A2A58" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#C59BFF" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#6D28D9" RegionColor="#F8F5FF" BaseHigh="#1A1426" ErrorText="#B3261E" />
                <ColorPaletteResources x:Key="Dark" Accent="#9B3DFF" RegionColor="#000000" BaseHigh="#F6F0FF" ErrorText="#FF8F80" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        </Style>

        <!-- Text -->
        <Style Selector=":is(TextBlock).muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="{DynamicResource PageTitleFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.rowTitle">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowTitleFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.emptyTitle">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="{DynamicResource EmptyTitleFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Icons: 20 x 20 strokes that take the colour of the button they sit in. -->
        <Style Selector="Path.icon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.textLink Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource LinkTextBrush}" />
        </Style>
        <Style Selector="Button.textLink:pointerover Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        </Style>
        <Style Selector="Button.textLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource LinkTextBrush}" />
        </Style>
        <Style Selector="Button.textLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.textLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.textLink:pointerover TextBlock">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
        </Style>
        <Style Selector="Button.openAll">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="{DynamicResource OpenAllFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.openAll:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>

        <!-- Poster cards: a flat button; the frame takes an accent ring on hover or keyboard focus, and a faded look when hidden or missing. -->
        <Style Selector="Button.card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.card Border.frame">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card:pointerover Border.frame">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.card:focus-visible Border.frame">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.card Border.playOverlay">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card:pointerover Border.playOverlay, Button.card:focus-visible Border.playOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="StackPanel.dimmed, DockPanel.dimmed, Grid.dimmed">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Surfaces: a panel, and a flat group that sits inside a panel without a second border. -->
        <Style Selector="Border.panel">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.panel Border.panel">
            <Setter Property="Padding" Value="0,4,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ChipRadius}" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Border.kbd">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
        </Style>

        <!-- Caption buttons: drawn by the app, 46 x 40, the way Windows draws its own. -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="User" />
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A32316" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.caption Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover Path">
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.caption.close:pressed Path">
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>

        <!-- Dialog frame: the title strip every dialog draws in place of the system's. -->
        <Style Selector="controls|DialogFrame">
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="40" ColumnDefinitions="*,Auto">
                            <Border Grid.ColumnSpan="2" Background="Transparent"
                                    chrome:WindowDecorationProperties.ElementRole="TitleBar" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <Image Source="avares://MediaBoard.Desktop/Assets/app-mark.png" Width="20" Height="20"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                <TextBlock Text="{TemplateBinding Title}" FontSize="{DynamicResource SmallFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- The content is the word, for screen readers and tests; the template draws the cross. -->
                            <Button Grid.Column="1" x:Name="PART_Close" Classes="caption close" Content="Close" ToolTip.Tip="Close">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <Path Data="M5.5 5.5 L14.5 14.5 M14.5 5.5 L5.5 14.5" />
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </Grid>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
